# Copy to .env and fill in. Never commit the real .env.

# ---- Gemini (both agents) ----
# Billed per call, but only when someone actually chats — not per visitor.
# With neither of the two below set, the agents reply with a "not configured"
# message; everything else (provisioning, payment timer, admin) keeps working.
#
# There are two ways in. Same models, same code — only how the client
# authenticates differs, so switching later is one env var.
#
# A) Gemini Developer API — one key, no cloud project, has a free tier.
#    Get it from https://aistudio.google.com/apikey
GEMINI_API_KEY=
#
# B) Vertex AI — needs a GCP project with billing and a service account
#    ("Vertex AI User" role) whose JSON key sits at
#    {HOST_DATA_ROOT}/gcp-credentials.json on the server. That tree is already
#    mounted into the container, so docker-compose just points
#    GOOGLE_APPLICATION_CREDENTIALS at it. Bills through GCP, which is the
#    reason to prefer it as a registered business.
GOOGLE_CLOUD_PROJECT=
# "global" routes to the nearest region and is the right default. Pin a
# region (e.g. asia-northeast3 for Seoul) only if data residency requires it —
# a pinned region carries fewer models than global does.
GOOGLE_CLOUD_LOCATION=global

# If both are set the key wins. Whichever backend runs, this is the model:
GEMINI_MODEL=gemini-3.7-flash

# ---- Admin ----
# Shared secret for /admin (payment confirmation, server list). Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# Blank means the admin endpoints refuse every request.
ADMIN_TOKEN=

# ---- Sign in with Google ----
# Accounts have no passwords; identity comes from Google. Create an OAuth 2.0
# Client ID of type "Web application" in the Google Cloud console (APIs &
# Services -> Credentials) and register the callback below as an authorised
# redirect URI, byte for byte.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Where Google sends the browser back — {this}/api/auth/google/callback.
# Google accepts ONLY public https origins and http://localhost; a LAN address
# like http://192.168.45.100:8000 is refused when you register it. Until a
# real domain is in place, keep this on localhost and reach the backend with
#   ssh -L 8000:localhost:8000 sean@192.168.45.100
# then use http://localhost:8000. Blank means "use PUBLIC_BASE_URL", which is
# the right setting once the domain exists.
OAUTH_REDIRECT_BASE=http://localhost:8000

# ---- Discord ----
# Outbound notifications only — no bot, so no gateway connection to maintain.
DISCORD_WEBHOOK_URL=

# Public invite to the support server, shown to customers on the session page.
# Blank hides those links rather than shipping a dead one.
DISCORD_INVITE_URL=https://discord.gg/FFUJpmxrh

# ---- Capacity budget ----
# Set below the box's real specs to leave headroom for the OS, this backend,
# and the local LLM. Not auto-detected on purpose.
HOST_RAM_MB_BUDGET=24576
HOST_STORAGE_GB_BUDGET=260
MAX_CONCURRENT_SERVERS=4

# ---- Payment ----
# Minutes an unpaid server stays up before it is STOPPED (never deleted).
PAYMENT_GRACE_MINUTES=60

# ---- Server defaults ----
# LATEST tracks the current Minecraft release (26.2 as of 2026-08).
# Note Paper 26.x requires Java 25 inside the container -- itzg handles that.
DEFAULT_MC_VERSION=LATEST
DEFAULT_MC_TYPE=PAPER
MC_PORT_RANGE_START=25565
MC_PORT_RANGE_END=25664

# ---- Paths and public addresses ----
# Absolute HOST path, mounted at the identical path inside the container so
# bind mounts this backend requests resolve correctly on the host.
HOST_DATA_ROOT=/srv/minecraft/data

# Where customer worlds live. Kept separate from HOST_DATA_ROOT so the big
# data can sit on the HDD while the small SQLite database stays on the SSD.
HOST_WORLDS_ROOT=/mnt/hdd/minecraft/worlds

# How the backend refers to itself in links, and where players connect.
# Both must become real public addresses once the box is reachable outside the LAN.
PUBLIC_BASE_URL=http://192.168.45.100:8000
MINECRAFT_PUBLIC_HOST=192.168.45.100

CORS_ALLOW_ORIGIN=*
