# Copy to .env and fill in. Never commit the real .env.

# ---- Claude API (both agents) ----
# Billed per call, but only when someone actually chats — not per visitor.
# Without it the agents reply with a "not configured" message; everything
# else (provisioning, payment timer, admin) keeps working.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# ---- Admin ----
# Shared secret for /admin (payment confirmation, server list). Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# Blank means the admin endpoints refuse every request.
ADMIN_TOKEN=

# ---- Discord ----
# Outbound notifications only — no bot, so no gateway connection to maintain.
DISCORD_WEBHOOK_URL=

# Public invite to the support server, shown to customers on the session page.
# Blank hides those links rather than shipping a dead one.
DISCORD_INVITE_URL=https://discord.gg/FFUJpmxrh

# ---- Capacity budget ----
# Set below the box's real specs to leave headroom for the OS, this backend,
# and the local LLM. Not auto-detected on purpose.
HOST_RAM_MB_BUDGET=24576
HOST_STORAGE_GB_BUDGET=260
MAX_CONCURRENT_SERVERS=4

# ---- Payment ----
# Minutes an unpaid server stays up before it is STOPPED (never deleted).
PAYMENT_GRACE_MINUTES=60

# ---- Server defaults ----
# LATEST tracks the current Minecraft release (26.2 as of 2026-08).
# Note Paper 26.x requires Java 25 inside the container -- itzg handles that.
DEFAULT_MC_VERSION=LATEST
DEFAULT_MC_TYPE=PAPER
MC_PORT_RANGE_START=25565
MC_PORT_RANGE_END=25664

# ---- Paths and public addresses ----
# Absolute HOST path, mounted at the identical path inside the container so
# bind mounts this backend requests resolve correctly on the host.
HOST_DATA_ROOT=/srv/minecraft/data

# Where customer worlds live. Kept separate from HOST_DATA_ROOT so the big
# data can sit on the HDD while the small SQLite database stays on the SSD.
HOST_WORLDS_ROOT=/mnt/hdd/minecraft/worlds

# How the backend refers to itself in links, and where players connect.
# Both must become real public addresses once the box is reachable outside the LAN.
PUBLIC_BASE_URL=http://192.168.45.100:8000
MINECRAFT_PUBLIC_HOST=192.168.45.100

CORS_ALLOW_ORIGIN=*
