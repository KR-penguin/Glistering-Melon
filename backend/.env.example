# Copy to .env and fill in. Never commit the real .env.

# Anthropic (Minecraft ops agent) — real per-call cost, unlike the
# notification pipeline below. Only spent when someone actually chats an
# ops request in the Discord ops channel.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# Discord — the webhook is the same one already wired into Landing.dc.html
# for "new application" notifications; the bot is a separate credential
# (Discord Developer Portal > New Application > Bot > copy token) used only
# for the ops agent's chat channel.
DISCORD_WEBHOOK_URL=
DISCORD_BOT_TOKEN=
DISCORD_OPS_CHANNEL_ID=

# Gmail SMTP (applicant emails) — free within Gmail's own sending quota.
# Needs 2FA enabled on the account, then an App Password (myaccount.google.com
# > Security > App passwords). Do not use the real account password here.
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=

# Capacity budget — set below your box's real specs to leave headroom for
# the OS, this backend, and the agent itself. Not auto-detected on purpose.
HOST_RAM_MB_BUDGET=24576
HOST_STORAGE_GB_BUDGET=400
MAX_CONCURRENT_SERVERS=6

# Server defaults
DEFAULT_MC_VERSION=1.21.1
DEFAULT_MC_TYPE=PAPER
MC_PORT_RANGE_START=25565
MC_PORT_RANGE_END=25664

# Absolute HOST path where SQLite + world volumes live. Must be absolute:
# docker-compose.yml mounts it at the identical path inside the container so
# that bind mounts this backend requests resolve correctly on the host.
HOST_DATA_ROOT=/srv/minecraft/data

# Set to the real site origin once deployed (CORS). "*" is fine for local dev.
CORS_ALLOW_ORIGIN=*
